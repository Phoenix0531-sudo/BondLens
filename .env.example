# Optional for this session-free app; set a random stable value if adding sessions.
SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=
OPENAI_API_STYLE=auto
OPENAI_TIMEOUT_SECONDS=20
BOND_DATA_MODE=auto
# Compose host binding: default 127.0.0.1 (local machine only).
# Set BOND_BIND_HOST=0.0.0.0 or a LAN IP only behind a trusted network / authenticating reverse proxy.
BOND_BIND_HOST=127.0.0.1
BOND_HOST_PORT=8765
BOND_LIVE_CACHE_PATH=
BOND_LIVE_CACHE_MAX_AGE_HOURS=24
BOND_REPLAY_ENABLED=true
BOND_REPLAY_DIR=
